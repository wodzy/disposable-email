{
    "name": "wodzy/disposable-email",
    "description": "Lightweight, dependency-free PHP library that blocks disposable (throwaway) email addresses, with your own block lists and never-blocked domains.",
    "type": "library",
    "keywords": [
        "email",
        "blocklist",
        "disposable-email",
        "validation",
        "spam",
        "domain",
        "throwaway-email",
        "temporary-email"
    ],
    "homepage": "https://github.com/wodzy/disposable-email",
    "license": "MIT",
    "authors": [
        {
            "name": "Walid Oukaci",
            "email": "hello@oukaci.com",
            "homepage": "https://github.com/wodzy",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/wodzy/disposable-email/issues",
        "source": "https://github.com/wodzy/disposable-email"
    },
    "require": {
        "php": "^8.2",
        "ext-filter": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.88"
    },
    "suggest": {
        "ext-intl": "Required for IDN (internationalized domain name) normalization via UTS-46. Without it, Unicode and Punycode forms of the same domain will not match."
    },
    "autoload": {
        "psr-4": {
            "Wodzy\\DisposableEmail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wodzy\\DisposableEmail\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html build/coverage",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "qa": [
            "@cs:check",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
